
{% extends 'base.html.twig' %}

{% block title %}Cart{% endblock %}

{% block body %}

<div class="dashboard-container">

    <aside class="sidebar">
        {% include 'sidebar/index.html.twig' %}
    </aside>

    <main class="dashboard-content">

        <header class="dashboard-header">
            <h1>Cart</h1>
            <p>Review your selected pizzas before placing your order.</p>
        </header>

        <section class="cart-section">

            <div id="cart-empty" class="cart-empty" style="display: none;">
                <div class="cart-icon">🛒</div>
                <h2>Your Cart is Empty</h2>
                <p>You haven't added any pizzas to your cart yet.</p>
                <a href="{{ path('app_menu') }}">Browse Our Menu</a>
            </div>

            <div id="cart-content" style="display: none;">

                <div id="cart-items" class="cart-items"></div>

                <div class="cart-summary">
                    <h2>Order Summary</h2>

                    <div class="total-row">
                        <span>Total</span>
                        <strong id="cart-total">₱0.00</strong>
                    </div>

                    <a href="{{ path('app_menu') }}" class="continue-shopping">
                        Continue Shopping
                    </a>
                </div>

            </div>

        </section>

    </main>

</div>

<style>
.dashboard-header {
    margin-bottom: 30px;
}

.dashboard-header h1 {
    margin: 0 0 8px;
    color: #fff;
    font-size: 30px;
    font-weight: 600;
}

.dashboard-header p {
    margin: 0;
    color: #a8a8a8;
    font-size: 15px;
}

.cart-section {
    margin-top: 10px;
}

.cart-empty,
.cart-item,
.cart-summary {
    padding: 25px;
    background-color: #181818;
    border: 1px solid #292929;
    border-radius: 10px;
}

.cart-empty {
    padding: 60px 30px;
    text-align: center;
}

.cart-icon {
    margin-bottom: 15px;
    font-size: 42px;
}

.cart-empty h2,
.cart-summary h2 {
    margin: 0 0 10px;
    color: #fff;
}

.cart-empty p {
    margin: 0 0 25px;
    color: #a8a8a8;
    font-size: 14px;
}

.cart-empty a,
.continue-shopping {
    display: inline-block;
    padding: 11px 18px;
    background-color: #2a2a2a;
    border-radius: 6px;
    color: #fff;
    text-decoration: none;
    font-size: 14px;
}

.cart-empty a:hover,
.continue-shopping:hover {
    background-color: #3a3a3a;
}

.cart-items {
    display: grid;
    gap: 15px;
    margin-bottom: 20px;
}

.cart-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.cart-item h3 {
    margin: 0 0 8px;
    color: #fff;
    font-size: 17px;
}

.cart-item p {
    margin: 0 0 8px;
    color: #a8a8a8;
    font-size: 14px;
}

.cart-item-price {
    color: #66bb6a;
    font-weight: 600;
}

.cart-item-actions {
    display: flex;
    align-items: center;
    gap: 8px;
}

.cart-item-actions button {
    padding: 7px 11px;
    background: #292929;
    border: 1px solid #444;
    border-radius: 5px;
    color: #fff;
    cursor: pointer;
}

.cart-item-actions .remove-item {
    background: #7f1d1d;
    border-color: #7f1d1d;
}

.cart-summary {
    margin-top: 20px;
}

.total-row {
    display: flex;
    justify-content: space-between;
    margin: 20px 0;
    padding-top: 15px;
    border-top: 1px solid #333;
    color: #fff;
}

#cart-total {
    color: #66bb6a;
    font-size: 22px;
}

@media (max-width: 600px) {
    .cart-item {
        align-items: flex-start;
        flex-direction: column;
    }
}
</style>


<script>
(function () {
    function initializeCart() {
        const emptyMessage = document.getElementById('cart-empty');
        const cartContent = document.getElementById('cart-content');
        const cartItemsContainer = document.getElementById('cart-items');
        const cartTotalElement = document.getElementById('cart-total');

        if (!emptyMessage || !cartContent || !cartItemsContainer || !cartTotalElement) {
            return;
        }

        function getCart() {
            try {
                const cart = JSON.parse(localStorage.getItem('pizzaCart') || '[]');
                return Array.isArray(cart) ? cart : [];
            } catch (error) {
                return [];
            }
        }

        function saveCart(cart) {
            localStorage.setItem('pizzaCart', JSON.stringify(cart));
        }

        function renderCart() {
            const cart = getCart();
            cartItemsContainer.replaceChildren();

            if (cart.length === 0) {
                emptyMessage.style.display = 'block';
                cartContent.style.display = 'none';
                cartTotalElement.textContent = '₱0.00';
                return;
            }

            emptyMessage.style.display = 'none';
            cartContent.style.display = 'block';

            let total = 0;

            cart.forEach(function (item, index) {
                const price = Number(item.price) || 0;
                const quantity = Math.max(1, Number(item.quantity) || 1);
                total += price * quantity;

                const card = document.createElement('div');
                card.className = 'cart-item';

                const details = document.createElement('div');

                const name = document.createElement('h3');
                name.textContent = item.name || 'Pizza';

                const size = document.createElement('p');
                size.textContent = 'Size: ' + (item.size || 'Not specified');

                const priceLine = document.createElement('p');
                priceLine.className = 'cart-item-price';
                priceLine.textContent = '₱' +
                    (price * quantity).toLocaleString('en-PH', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });

                details.append(name, size, priceLine);

                const actions = document.createElement('div');
                actions.className = 'cart-item-actions';

                const decrease = document.createElement('button');
                decrease.type = 'button';
                decrease.textContent = '−';
                decrease.setAttribute('aria-label', 'Decrease quantity');

                decrease.addEventListener('click', function () {
                    const updatedCart = getCart();
                    if (!updatedCart[index]) return;

                    const currentQuantity =
                        Math.max(1, Number(updatedCart[index].quantity) || 1);

                    if (currentQuantity > 1) {
                        updatedCart[index].quantity = currentQuantity - 1;
                        saveCart(updatedCart);
                        renderCart();
                    }
                });

                const quantityText = document.createElement('span');
                quantityText.style.color = '#fff';
                quantityText.textContent = quantity;

                const increase = document.createElement('button');
                increase.type = 'button';
                increase.textContent = '+';
                increase.setAttribute('aria-label', 'Increase quantity');

                increase.addEventListener('click', function () {
                    const updatedCart = getCart();
                    if (!updatedCart[index]) return;

                    updatedCart[index].quantity =
                        (Number(updatedCart[index].quantity) || 1) + 1;

                    saveCart(updatedCart);
                    renderCart();
                });

                const remove = document.createElement('button');
                remove.type = 'button';
                remove.className = 'remove-item';
                remove.textContent = 'Remove';

                remove.addEventListener('click', function () {
                    const updatedCart = getCart();
                    updatedCart.splice(index, 1);
                    saveCart(updatedCart);
                    renderCart();
                });

                actions.append(decrease, quantityText, increase, remove);
                card.append(details, actions);
                cartItemsContainer.appendChild(card);
            });

            cartTotalElement.textContent = '₱' +
                total.toLocaleString('en-PH', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
        }

        // Keep the latest Cart page renderer available.
        window.renderPizzaCart = renderCart;
        renderCart();
    }

    // Initialize whether the page is loading or already loaded.
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeCart, {
            once: true
        });
    } else {
        initializeCart();
    }

    // Reinitialize after Symfony Turbo navigation.
    document.addEventListener('turbo:load', initializeCart);

    // Refresh the current Cart when returning to the page.
    window.addEventListener('pageshow', function () {
        if (window.renderPizzaCart) window.renderPizzaCart();
    });

    window.addEventListener('focus', function () {
        if (window.renderPizzaCart) window.renderPizzaCart();
    });

    // Updates made in another browser tab.
    window.addEventListener('storage', function () {
        if (window.renderPizzaCart) window.renderPizzaCart();
    });
})();
</script>


{% endblock %}
