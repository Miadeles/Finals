{% extends 'base.html.twig' %}

{% block title %}Login | La Mia Pizzeria{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <style>
        .login-page {
            min-height: 85vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
            background: #111111;
        }

        .login-card {
            width: 100%;
            max-width: 440px;
            padding: 45px 40px;
            background: #1b1b1b;
            border: 1px solid #3a2929;
            border-radius: 16px;
            box-shadow: 0 15px 45px rgba(0, 0, 0, 0.45);
        }

        .login-brand {
            text-align: center;
            margin-bottom: 30px;
        }

        .login-brand h1 {
            color: #f4ebdd;
            font-size: 30px;
            font-weight: bold;
            letter-spacing: 2px;
            margin-bottom: 8px;
        }

        .login-brand span {
            color: #a52a32;
        }

        .login-brand p {
            color: #aaa;
            font-size: 14px;
            margin: 0;
        }

        .login-card h2 {
            color: #f4ebdd;
            text-align: center;
            font-size: 23px;
            margin-bottom: 25px;
        }

        .login-card label {
            display: block;
            color: #e8dfd2;
            font-size: 14px;
            margin-bottom: 8px;
        }

        .login-card input[type="email"],
        .login-card input[type="password"] {
            width: 100%;
            padding: 13px 14px;
            margin-bottom: 20px;
            background: #111;
            border: 1px solid #444;
            border-radius: 8px;
            color: #fff;
            outline: none;
            box-sizing: border-box;
        }

        .login-card input:focus {
            border-color: #a52a32;
            box-shadow: 0 0 0 2px rgba(165, 42, 50, 0.2);
        }

        .remember-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 24px;
            color: #ccc;
            font-size: 14px;
        }

        .remember-row input {
            accent-color: #a52a32;
        }

        .login-button {
            width: 100%;
            padding: 14px;
            background: #8b2026;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            font-weight: bold;
            letter-spacing: 1px;
            cursor: pointer;
            transition: background 0.2s ease;
        }

        .login-button:hover {
            background: #a52a32;
        }

        .login-footer {
            text-align: center;
            color: #aaa;
            font-size: 13px;
            margin-top: 25px;
        }

        .login-footer a {
            color: #d6aa78;
            text-decoration: none;
        }

        .login-footer a:hover {
            color: #f4ebdd;
            text-decoration: underline;
        }

        .login-card .alert {
            margin-bottom: 20px;
        }

        @media (max-width: 480px) {
            .login-card {
                padding: 35px 24px;
            }

            .login-brand h1 {
                font-size: 25px;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="login-page">
    <div class="login-card">

        <div class="login-brand">
            <h1>LA MIA <span>PIZZERIA</span></h1>
            <p>Authentic Italian Taste, Made with Love</p>
        </div>

        <h2>Welcome Back</h2>

        <form method="post">

            {% if error %}
                <div class="alert alert-danger">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {% if app.user %}
                <div class="mb-3 text-light">
                    You are logged in as {{ app.user.userIdentifier }},
                    <a href="{{ logout_path() }}">Logout</a>
                </div>
            {% endif %}

            <label for="inputEmail">Email Address</label>
            <input
                type="email"
                value="{{ last_username }}"
                name="email"
                id="inputEmail"
                autocomplete="email"
                placeholder="Enter your email"
                required
                autofocus
            >

            <label for="inputPassword">Password</label>
            <input
                type="password"
                name="password"
                id="inputPassword"
                autocomplete="current-password"
                placeholder="Enter your password"
                required
            >

            <input
                type="hidden"
                name="_csrf_token"
                data-controller="csrf-protection"
                value="{{ csrf_token('authenticate') }}"
            >

            <div class="remember-row">
                <input type="checkbox" name="_remember_me" id="rememberMe">
                <label for="rememberMe" style="margin: 0;">
                    Remember me
                </label>
            </div>

            <button class="login-button" type="submit">
                LOGIN
            </button>

        </form>

        <div class="login-footer">
            Welcome to La Mia Pizzeria.
            <br>
            Don't have an account?
            <a href="{{ path('app_register') }}">Create one</a>
        </div>

    </div>
</div>
{% endblock %}
