{% extends 'base.html.twig' %}

{% block title %}Home{% endblock %}

{% block body %}

<div class="dashboard-container">

    <aside class="sidebar">
        {% include 'sidebar/index.html.twig' %}
    </aside>

    <main class="dashboard-content">

        <header class="dashboard-header">
            <h1>Home</h1>
            <p>Welcome to La Mia Pizzeria.</p>
        </header>

        <section class="dashboard-overview">

            <article class="dashboard-card">
                <h2>Welcome</h2>
                <p>This is the home page of La Mia Pizzeria.</p>
            </article>

        </section>

    </main>

</div>

<style>
    .dashboard-header {
        margin-bottom: 30px;
    }

    .dashboard-header h1 {
        margin: 0 0 8px 0;
        font-size: 28px;
        font-weight: 600;
    }

    .dashboard-header p {
        margin: 0;
        color: #a8a8a8;
    }

    .dashboard-overview {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
    }

    .dashboard-card {
        padding: 24px;
        background-color: #181818;
        border: 1px solid #292929;
        border-radius: 10px;
    }

    .dashboard-card h2 {
        margin: 0 0 10px 0;
        color: #ffffff;
        font-size: 18px;
    }

    .dashboard-card p {
        margin: 0;
        color: #a8a8a8;
    }
</style>

{% endblock %}