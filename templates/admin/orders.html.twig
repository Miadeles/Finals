
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Admin Orders | La Mia Pizzeria</title>
    <style>
        * { box-sizing: border-box; }

        body {
            margin: 0;
            padding: 30px;
            background: #f5f2ee;
            color: #292521;
            font-family: Arial, sans-serif;
        }

        .container {
            max-width: 1200px;
            margin: auto;
        }

        h1 { color: #8b2026; }

        .subtitle { color: #666; }

        .message {
            padding: 12px 16px;
            margin: 12px 0;
            border-radius: 8px;
            background: #e2f4e5;
        }

        .error { background: #ffe2e2; }

        .order {
            background: white;
            padding: 22px;
            margin: 20px 0;
            border-radius: 12px;
            box-shadow: 0 3px 12px #0000000c;
        }

        .order-header {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            border-bottom: 1px solid #eee;
            padding-bottom: 12px;
        }

        .status {
            display: inline-block;
            padding: 6px 10px;
            border-radius: 20px;
            background: #fff0cb;
            font-size: 13px;
            font-weight: bold;
        }

        .details {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            margin: 18px 0;
        }

        .label {
            color: #777;
            font-size: 12px;
            text-transform: uppercase;
            margin-bottom: 6px;
        }

        .items {
            padding-left: 20px;
            line-height: 1.8;
        }

        .total {
            font-size: 20px;
            font-weight: bold;
            color: #8b2026;
        }

        select, button {
            padding: 10px 12px;
            border-radius: 6px;
            border: 1px solid #ccc;
            font-size: 14px;
        }

        button {
            background: #8b2026;
            color: white;
            border: 0;
            cursor: pointer;
        }

        button:hover { background: #6f171c; }

        form {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            align-items: center;
        }

        .empty {
            background: white;
            padding: 25px;
            border-radius: 10px;
        }

        @media (max-width: 600px) {
            body { padding: 16px; }
            .order { padding: 16px; }
        }
    </style>
</head>
<body>
<div class="container">
    <h1>La Mia Pizzeria — Admin Orders</h1>
    <p class="subtitle">View customer orders and update their delivery status.</p>

    {% for message in app.flashes('success') %}
        <div class="message">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="message error">{{ message }}</div>
    {% endfor %}

    <h2>All Orders ({{ orders|length }})</h2>

    {% for order in orders %}
        <section class="order">
            <div class="order-header">
                <h2>Order #{{ order.id }}</h2>
                <span class="status">{{ order.status }}</span>
            </div>

            <div class="details">
                <div>
                    <div class="label">Customer</div>
                    <strong>{{ order.customerName }}</strong>
                </div>

                <div>
                    <div class="label">Phone</div>
                    {{ order.customerPhone }}
                </div>

                <div>
                    <div class="label">Delivery Address</div>
                    {{ order.customerAddress }}
                </div>
            </div>

            <h3>Order Items</h3>
            <ul class="items">
                {% for item in order.orderItems %}
                    <li>
                        {{ item.pizzaName }} — {{ item.pizzaSize }}
                        × {{ item.quantity }}
                        (₱{{ (item.price * item.quantity)|number_format(2, '.', ',') }})
                    </li>
                {% endfor %}
            </ul>

            <p class="total">
                Total: ₱{{ order.total|number_format(2, '.', ',') }}
            </p>

            <form method="post"
                  action="{{ path('admin_order_status', {id: order.id}) }}">
                <input type="hidden"
                       name="_token"
                       value="{{ csrf_token('update_order_status_' ~ order.id) }}">

                <label for="status-{{ order.id }}">Update status:</label>

                <select id="status-{{ order.id }}" name="status">
                    {% for status in [
                        'Pending',
                        'Preparing',
                        'Out for Delivery',
                        'Delivered',
                        'Cancelled'
                    ] %}
                        <option value="{{ status }}"
                            {% if order.status == status %}selected{% endif %}>
                            {{ status }}
                        </option>
                    {% endfor %}
                </select>

                <button type="submit">Save Status</button>
            </form>
        </section>
    {% else %}
        <div class="empty">No orders have been placed yet.</div>
    {% endfor %}
</div>
</body>
</html>
