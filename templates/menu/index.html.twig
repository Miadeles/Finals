
{% extends 'base.html.twig' %}

{% block title %}Menu{% endblock %}

{% block body %}

<div class="dashboard-container">

    <aside class="sidebar">
        {% include 'sidebar/index.html.twig' %}
    </aside>

    <main class="dashboard-content">

        <header class="dashboard-header">
            <h1>Menu</h1>
            <p>Explore our delicious La Mia Pizzeria pizzas.</p>
        </header>

        <section class="menu-section">

            <div class="menu-introduction">
                <h2>Our Pizza Menu</h2>
                <p>Fresh ingredients, delicious flavors, and pizza made with love.</p>
            </div>

            
            <div class="pizza-grid">

                {% set sizePrices = {
                    'Pepperoni Pizza': {'Small': 399, 'Medium': 449, 'Large': 499},
                    'Margherita Pizza': {'Small': 349, 'Medium': 399, 'Large': 449},
                    'Creamy Spinach Pizza': {'Small': 429, 'Medium': 479, 'Large': 529},
                    'New York Style Pizza': {'Small': 449, 'Medium': 499, 'Large': 549},
                    'Hawaiian Pizza': {'Small': 429, 'Medium': 479, 'Large': 529},
                    'Spinach & Glazed Bacon Pizza': {'Small': 459, 'Medium': 509, 'Large': 559},
                    'Extravaganzza Pizza': {'Small': 499, 'Medium': 549, 'Large': 599},
                    'Cheese Mania Pizza': {'Small': 449, 'Medium': 499, 'Large': 549},
                    'American Bacon & Cheeseburger Pizza': {'Small': 479, 'Medium': 529, 'Large': 579}
                } %}

                {% for product in products %}
                    {% set productName = product.name %}
                    {% set prices = sizePrices[productName]|default({'Small': product.price, 'Medium': product.price, 'Large': product.price}) %}
                    {% set imageName = product.image|default('') %}

                    <article class="pizza-card">
                        <div class="pizza-image">
                            {% if imageName %}
                                <img src="{{ asset('images/' ~ imageName) }}" alt="{{ productName }}">
                            {% endif %}
                        </div>

                        <div class="pizza-info">
                            <h3>{{ productName }}</h3>
                            <p>{{ product.description|default('Freshly prepared with delicious ingredients.') }}</p>

                            <div class="pizza-prices">
                                {% for size, price in prices %}
                                    <label class="size-option">
                                        <input
                                            type="checkbox"
                                            name="product-{{ product.id }}-size[]"
                                            value="{{ size }} - ₱{{ price }}"
                                        >
                                        <span class="size-box">
                                            <span>{{ size }}</span>
                                            <strong>₱{{ price }}</strong>
                                        </span>
                                    </label>
                                {% endfor %}
                            </div>

                            <div class="pizza-order">
                                <button type="button">Add to Cart</button>
                            </div>
                        </div>
                    </article>
                {% else %}
                    <p>No products have been added yet. Please add products using the Product management page.</p>
                {% endfor %}

            </div>

        </section>
    </main>
</div>

<style>
.dashboard-header {
    margin-bottom: 30px;
}

.dashboard-header h1 {
    margin: 0 0 8px 0;
    font-size: 28px;
    font-weight: 600;
}

.dashboard-header p {
    margin: 0;
    color: #a8a8a8;
}

.menu-section {
    margin-top: 10px;
}

.menu-introduction {
    margin-bottom: 25px;
}

.menu-introduction h2 {
    margin: 0 0 8px 0;
    color: #ffffff;
    font-size: 22px;
    font-weight: 600;
}

.menu-introduction p {
    margin: 0;
    color: #a8a8a8;
}

.pizza-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    align-items: stretch;
}

.pizza-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
    box-sizing: border-box;
    background-color: #181818;
    border: 1px solid #292929;
    border-radius: 10px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.pizza-card:hover {
    border-color: #7f1d1d;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.35);
}

.pizza-image {
    width: 100%;
    height: 190px;
    overflow: hidden;
    flex-shrink: 0;
    background-color: #242424;
}

.pizza-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.3s ease;
}

.pizza-card:hover .pizza-image img {
    transform: scale(1.04);
}

.pizza-info {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 20px;
    box-sizing: border-box;
}

.pizza-info h3 {
    margin: 0 0 10px 0;
    color: #ffffff;
    font-size: 17px;
    line-height: 1.3;
}

.pizza-info p {
    margin: 0 0 20px 0;
    color: #a8a8a8;
    font-size: 14px;
    line-height: 1.5;
    min-height: 63px;
}

.pizza-prices {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-top: auto;
    margin-bottom: 18px;
}

.size-option {
    display: block;
    cursor: pointer;
}

.size-option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
}

.size-option input:focus-visible + .size-box {
    outline: 2px solid #66bb6a;
    outline-offset: 2px;
}

.size-box {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: 65px;
    padding: 8px 5px;
    box-sizing: border-box;
    background-color: #222222;
    border: 2px solid #333333;
    border-radius: 7px;
    color: #a8a8a8;
    text-align: center;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
}

.size-box span {
    font-size: 11px;
    font-weight: 500;
}

.size-box strong {
    margin-top: 4px;
    color: #ffffff;
    font-size: 15px;
}

/* Selected sizes stay highlighted green */
.size-option input:checked + .size-box {
    background-color: rgba(46, 125, 50, 0.2);
    border-color: #2e7d32;
    color: #66bb6a;
    box-shadow: 0 0 0 1px rgba(46, 125, 50, 0.2);
}

.size-option input:checked + .size-box strong {
    color: #66bb6a;
}

.size-option:hover .size-box {
    border-color: #4caf50;
}

.pizza-order {
    width: 100%;
    margin-top: auto;
}

.pizza-order button {
    width: 100%;
    padding: 12px 16px;
    background-color: #b91c1c;
    border: none;
    border-radius: 7px;
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease, box-shadow 0.2s ease;
}

.pizza-order button:hover {
    background-color: #dc2626;
    box-shadow: 0 5px 15px rgba(185, 28, 28, 0.25);
}

@media (max-width: 1100px) {
    .pizza-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 700px) {
    .pizza-grid {
        grid-template-columns: 1fr;
    }

    .pizza-prices {
        grid-template-columns: repeat(3, 1fr);
    }
}
</style>




    <script>
    function initializePizzaCart() {
        document.querySelectorAll('.pizza-card').forEach(function (card) {
            const button = card.querySelector('.pizza-order button');

            if (!button || button.dataset.cartInitialized === 'true') return;
            button.dataset.cartInitialized = 'true';

            const originalText = button.textContent.trim();

            button.addEventListener('click', function () {
                const name = card.querySelector('h3').textContent.trim();
                const checked = card.querySelectorAll('.size-option input:checked');

                if (checked.length === 0) {
                    alert('Please select at least one pizza size first.');
                    return;
                }

                let cart = [];

                try {
                    cart = JSON.parse(localStorage.getItem('pizzaCart') || '[]');
                    if (!Array.isArray(cart)) cart = [];
                } catch (error) {
                    cart = [];
                }

                let addedCount = 0;

                checked.forEach(function (input) {
                    const match = input.value.match(
                        /^(Small|Medium|Large)\s*-\s*₱([\d,.]+)$/
                    );

                    if (!match) return;

                    cart.push({
                        name: name,
                        size: match[1],
                        price: Number(match[2].replace(/,/g, '')),
                        quantity: 1
                    });

                    addedCount++;
                });

                if (addedCount === 0) {
                    alert('Could not read the selected pizza size.');
                    return;
                }

                try {
                    localStorage.setItem('pizzaCart', JSON.stringify(cart));
                    button.textContent = '✓ ADDED TO CART';

                    setTimeout(function () {
                        button.textContent = originalText;
                    }, 1500);
                } catch (error) {
                    alert('Could not save your cart. Check your browser storage settings.');
                    button.textContent = originalText;
                }
            });
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializePizzaCart, { once: true });
    } else {
        initializePizzaCart();
    }
    </script>



{% endblock %}


