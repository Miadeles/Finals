
{% extends 'base.html.twig' %}

{% block title %}Product index{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .action-btn {
            width: 70px;
            height: 32px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            margin-right: 4px;
        }

        .product-table th,
        .product-table td {
            vertical-align: middle;
            white-space: nowrap;
        }

        .product-table td.description-cell {
            white-space: normal;
            min-width: 220px;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="dashboard-container">
        <main class="dashboard-content">
            <h1 class="mb-4">Product index</h1>

            {# Button that opens the Create Product modal #}
            <button type="button"
                    class="btn btn-primary mb-3"
                    data-toggle="modal"
                    data-target="#createProductModal">
                Create New Product
            </button>

            <div class="table-responsive">
                <table class="table table-dark table-striped table-hover product-table">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Price</th>
                            <th>Image</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for product in products %}
                        <tr>
                            <td>{{ product.id }}</td>
                            <td>{{ product.name }}</td>
                            <td class="description-cell">{{ product.description }}</td>
                            <td>₱{{ product.price }}</td>
                            <td>{{ product.image }}</td>
                            <td>
                                <a class="btn btn-sm btn-info action-btn"
                                   href="{{ path('app_product_show', {'id': product.id}) }}">
                                    Show
                                </a>

                                <a class="btn btn-sm btn-warning action-btn"
                                   href="{{ path('app_product_edit', {'id': product.id}) }}">
                                    Edit
                                </a>

                                <form method="post"
                                      action="{{ path('app_product_delete', {'id': product.id}) }}"
                                      onsubmit="return confirm('Are you sure you want to delete this product?');"
                                      style="display: inline-block;">

                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('delete' ~ product.id) }}">

                                    <button type="submit" class="btn btn-sm btn-danger action-btn">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6">No records found.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </main>
    </div>

    {# Create Product Modal #}
    <div class="modal fade" id="createProductModal"
         tabindex="-1" role="dialog"
         aria-labelledby="createProductModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">

                {{ form_start(form, {'attr': {'id': 'createProductForm'}}) }}

                <div class="modal-header">
                    <h5 class="modal-title" id="createProductModalLabel">
                        Create New Product
                    </h5>

                    <button type="button" class="close"
                            data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="modal-body">
                    {{ form_errors(form) }}

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            {{ form_label(form.name, 'Product Name') }}
                            {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.name) }}
                        </div>

                        <div class="form-group col-md-6">
                            {{ form_label(form.category, 'Category') }}
                            {{ form_widget(form.category, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.category) }}
                        </div>
                    </div>

                    <div class="form-group">
                        {{ form_label(form.description, 'Description') }}
                        {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 3}}) }}
                        {{ form_errors(form.description) }}
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            {{ form_label(form.price, 'Base Price (legacy)') }}
                            {{ form_widget(form.price, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.price) }}
                        </div>

                        <div class="form-group col-md-6">
                            {{ form_label(form.image, 'Image Filename') }}
                            {{ form_widget(form.image, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.image) }}
                        </div>
                    </div>

                    <h6 class="mt-2">Product Size Prices</h6>

                    <div class="form-row">
                        <div class="form-group col-md-4">
                            {{ form_label(form.smallPrice, 'Small Price (₱)') }}
                            {{ form_widget(form.smallPrice, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.smallPrice) }}
                        </div>

                        <div class="form-group col-md-4">
                            {{ form_label(form.mediumPrice, 'Medium Price (₱)') }}
                            {{ form_widget(form.mediumPrice, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.mediumPrice) }}
                        </div>

                        <div class="form-group col-md-4">
                            {{ form_label(form.largePrice, 'Large Price (₱)') }}
                            {{ form_widget(form.largePrice, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.largePrice) }}
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            data-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" class="btn btn-success">
                        Save Product
                    </button>
                </div>

                {{ form_end(form) }}

            </div>
        </div>
    </div>
{% endblock %}
